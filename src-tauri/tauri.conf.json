{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kevcord",
  "version": "1.0.0",
  "identifier": "com.kevcord.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kevcord",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 320,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
